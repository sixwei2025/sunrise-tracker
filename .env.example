# 小红书配置（如果有API访问权限）
XHS_COOKIE=your_xiaohongshu_cookie_here

# AI分析配置（可选，用于爆点分析）
# 支持 OpenAI, Anthropic Claude 等
AI_PROVIDER=openai
AI_API_KEY=your_api_key_here
AI_MODEL=gpt-4

# 通知配置
NOTIFICATION_TYPE=console  # console, email, webhook
# 如果使用邮件通知
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your_email@gmail.com
EMAIL_PASSWORD=your_password
EMAIL_TO=recipient@example.com

# 如果使用Webhook（企业微信、飞书、钉钉等）
WEBHOOK_URL=your_webhook_url

# 定时任务配置
CRON_SCHEDULE=0 7 * * *  # 每天早上7点

# 检测配置
MIN_VIRAL_MULTIPLIER=10  # 阅读量至少是平均值的10倍才算爆文
MIN_VIEWS_THRESHOLD=1000  # 最低阅读量阈值
TOP_N_POSTS=10  # 每天推送前N篇
